#!/bin/bash
cd "$(dirname "$0")" || exit 1
find . -maxdepth 1 -type d -name '[0-9]*' ! -name '0' -exec rm -rf {} + 2>/dev/null
blockMesh > log.blockMesh 2>&1 || { echo "blockMesh FAIL"; exit 0; }
checkMesh > log.checkMesh 2>&1
if [ -f system/setExprFieldsDict ]; then setExprFields > log.set 2>&1 || echo "setExprFields FAIL"; fi
solidDisplacementFoam > log.run 2>&1 || echo "solver FAIL (see log.run)"
postProcess -func writeCellCentres > log.cc 2>&1
exit 0