#!/bin/bash
cd "$(dirname "$0")" || exit 1
for v in 1D 2D 3D; do
  cd "run_$v" || continue
  find . -maxdepth 1 -type d -name '[0-9]*' ! -name '0' -exec rm -rf {} + 2>/dev/null
  blockMesh > log.blockMesh 2>&1 || echo "blockMesh FAIL run_$v"
  checkMesh > log.checkMesh 2>&1
  solidDisplacementFoam > log.run 2>&1 || echo "solver FAIL run_$v"
  cd ..
done
exit 0